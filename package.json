{
  "name": "terminal-control",
  "version": "1.0.0",
  "description": "**TeleTerm** cho phép bạn truy cập, giám sát và điều khiển toàn bộ các terminal (PowerShell, CMD, WSL, Claude Code, Aider, Python scripts...) trên laptop Windows từ điện thoại ở bất kỳ đâu qua Internet — không cần mở port router, không bị ngắt tiến trình khi mất mạng (Session Persistence) và có bàn phím ảo tối ưu cho mobile.",
  "main": "src/desktop/main.js",
  "scripts": {
    "start": "node src/server/index.js",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "generate-icons": "node scripts/generate-icons.js",
    "test": "node test/test-desktop-platform.js"
  },
  "build": {
    "appId": "com.teleterm.desktop",
    "productName": "TeleTerm",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "bin/**/*",
      "build/icon.*",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*",
      "**/*.ps1",
      "**/node-pty/**"
    ],
    "protocols": [
      {
        "name": "teleterm",
        "schemes": [
          "teleterm"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup.${ext}",
      "executableName": "TeleTerm"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TeleTerm 3D",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chromium-bidi": "^17.0.2",
    "devtools-protocol": "^0.0.1687809",
    "dotenv": "^18.0.5",
    "escalade": "^3.2.0",
    "express": "^5.2.1",
    "get-caller-file": "^2.0.5",
    "get-east-asian-width": "^1.7.0",
    "lilconfig": "^3.1.3",
    "mitt": "^3.0.1",
    "modern-tar": "^0.8.5",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "puppeteer": "^25.12.0",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "three": "^0.186.1",
    "typed-query-selector": "^2.12.3",
    "webdriver-bidi-protocol": "^0.4.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "keywords": [
    "teleterm",
    "desktop",
    "game-client",
    "terminal",
    "threejs",
    "mmo"
  ],
  "author": "TeleTerm Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  }
}
